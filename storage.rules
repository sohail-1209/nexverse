
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Default deny all access to other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Rules for answer attachments
    // Path: answers/{userId}/{fileName}
    match /answers/{userId}/{fileName} {
      // Allow authenticated users to upload (create) files into their own folder.
      // - Check if the user is authenticated.
      // - Check if the path's {userId} matches the authenticated user's UID.
      // - Optionally, check file size and content type.
      allow create: if request.auth != null && request.auth.uid == userId
                       && request.resource.size < 100 * 1024 * 1024 // Max 100MB
                       && (request.resource.contentType.matches('image/.*') ||
                           request.resource.contentType.matches('application/pdf') ||
                           request.resource.contentType.matches('application/msword') ||
                           request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document') ||
                           request.resource.contentType.matches('text/plain')
                          ); // Example content types

      // Allow anyone to read files. This makes links to attachments work publicly.
      // If you need more restrictive read access (e.g., only authenticated users, or only users who can see the answer),
      // this rule would need to be more complex, potentially involving custom claims or Firestore lookups (if feasible for your use case).
      allow read: if true;

      // Allow authenticated users to update their own files (e.g., metadata).
      // This is often less common for simple uploads but can be useful.
      allow update: if request.auth != null && request.auth.uid == userId;

      // Allow authenticated users to delete their own files.
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Example for user profile pictures, if you add that feature later
    // match /profilePictures/{userId}/{fileName} {
    //   allow read: if true; // Publicly readable
    //   allow write: if request.auth != null && request.auth.uid == userId
    //                 && request.resource.size < 5 * 1024 * 1024 // Max 5MB
    //                 && request.resource.contentType.matches('image/.*');
    // }
  }
}
