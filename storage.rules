
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Default deny all reads and writes to enforce explicit grants below.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Rules for answer attachments.
    // Assumes files are stored at: answers/{userId}/{originalFileName}
    // The {allPaths=**} segment after {userId} allows for potential future subfolder structures if needed,
    // while still matching direct files like answers/{userId}/{fileName}.
    match /answers/{userId}/{allPaths=**} {
      // Allow authenticated users to read answer attachments.
      // If answers and their attachments are meant to be fully public, change to `if true;`.
      allow read: if request.auth != null;

      // Allow write (upload, update metadata) only by the authenticated user into their own folder.
      // Includes checks for file size (max 100MB) and common content types.
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 100 * 1024 * 1024 // Max 100MB
                   && (request.resource.contentType.matches('image/.*') ||
                       request.resource.contentType.matches('application/pdf') ||
                       request.resource.contentType.matches('application/msword') ||
                       request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document') ||
                       request.resource.contentType.matches('text/plain'));

      // Allow delete only by the owner of the file (matching userId in the path).
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for FCMImages (e.g., images used in push notifications).
    // Path: FCMImages/{anyPathIncludingSubfoldersAndFileName}
    match /FCMImages/{allPaths=**} {
      // Allow anyone to read images from FCMImages (e.g., for display in notifications).
      allow read: if true;

      // Allow authenticated users to write to FCMImages.
      // SECURITY WARNING: This is a broad permission. For a production app,
      // uploads to a general folder like FCMImages should ideally be handled by a
      // backend service (e.g., Cloud Function with Admin SDK) or restricted to admin users
      // via application logic controlling the upload process.
      // Direct client-side writes by all authenticated users to a common folder can be risky.
      // This rule is a placeholder and should be reviewed and tightened based on your specific needs.
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024 // Max 5MB for notification images
                   && request.resource.contentType.matches('image/.*'); // Only images
    }
  }
}
